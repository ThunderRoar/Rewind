# ============================================================
# Rewind environment. Copy to `.env` and fill in.
# ============================================================

# ── CockroachDB ──────────────────────────────────────────
# Connection string from Cockroach Cloud console (Basic cluster).
DATABASE_URL=postgres://<user>:<password>@<host>:26257/<db>?sslmode=verify-full
DATABASE_URL_EU=                                    # optional - multi-region demo
COCKROACH_MCP_ENDPOINT=https://cockroachlabs.cloud/mcp
CCLOUD_API_KEY=                                     # ccloud CLI (replay showcase)

# ── AWS / Bedrock ────────────────────────────────────────
# Verify real IDs first: aws bedrock list-inference-profiles --region $AWS_REGION
AWS_REGION=us-east-1
# Local dev credentials (no AWS CLI needed - the SDK reads these from the env).
# IAM access key with Bedrock permissions (e.g. AmazonBedrockFullAccess).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_DEFAULT=amazon.nova-lite-v1:0          # cheap event summaries
BEDROCK_MODEL_DEMO=                                  # Claude inference-profile id for headliner replays (Haiku 4.5 or Sonnet 5)
BEDROCK_MODEL_CHEAP=                                 # Haiku 4.5 inference-profile id (dev + fan-out)
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0     # pass dimensions:512 -> schema VECTOR(512)
BEDROCK_REPLAY_TEMPERATURE=0                          # pinned decoding for attribution
S3_BUCKET_OVERFLOW=                                   # bucket name -> payloads >OVERFLOW_BYTES stored in S3 (required in deploy; CockroachDB caps at 16 MiB)
OVERFLOW_BYTES=65536                                  # overflow threshold in bytes (default 64KB)
SNS_TOPIC_ARN=                                        # SNS topic ARN -> incident alerts on fork/replay

# ── Access control (hierarchical multi-tenancy) ──────────
# Comma-separated `key:org[:agent][:role]` entries gate every non-health route.
#   key:org             -> company ADMIN (sees every sub-agent in that org)
#   key:org:agent       -> MEMBER (scoped to one sub-agent); cross-org is always denied
#   key:org::demo       -> DEMO: reads + capped replay, CANNOT write events or runs.
#                          Empty agent slot (`::`) = org-wide with an explicit role.
# An unrecognised role drops the entry entirely (fail closed), so a typo can't
# silently grant admin.
# Empty = auth OFF (local dev), unscoped.
# Three-key example: operator, public and a second company for the
# cross-org isolation beat. NOTE the demo key shares the OPERATOR's org — org
# controls data visibility, so a different org would show judges an empty UI.
#   REWIND_API_KEYS=rwd_op_key:me,rwd_judge_key:me::demo,rwd_acme_key:acme-fintech
REWIND_API_KEYS=
# A valid key the API's replay self-call + the SDK + the MCP server send outbound.
# Must be WRITE-capable (admin/member) and in the same org as the agents it replays,
# or ingestion is rejected mid-replay. Never reuse this value for the browser key below.
REWIND_API_KEY=
REPLAY_DEMO_HOURLY_USD_CAP=0.25
REPLAY_DEMO_DAILY_USD_CAP=2.00

# ── App ──────────────────────────────────────────────────
API_PORT=3000
API_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_REWIND_API_KEY=                          # public demo/judge key the web app sends.
# ^ Next.js inlines NEXT_PUBLIC_* into the BROWSER BUNDLE at build time. Use a `:demo`
# role key, never REWIND_API_KEY, and redeploy (not just re-set) after changing it.
CLERK_SECRET_KEY=
LOG_LEVEL=info
